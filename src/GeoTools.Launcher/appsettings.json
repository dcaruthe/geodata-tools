{
  "Window": {
    "Title": "GeoTools",
    "Width": 1200,
    "Height": 800
  },
  "Map": {
    "AdminLevels": [
      2
    ]
  },
  "Geodata": {
    "RootPath": "geodata",
    "BordersSubdirectory": "borders",
    "Regions": [
      "africa",
      "antarctica",
      "asia",
      "australia-oceania",
      "central-america",
      "europe",
      "north-america",
      "south-america"
    ],
    "SourceBaseUrl": "https://download.geofabrik.de/",
    "SourceFilePattern": "{region}-latest.osm.pbf",
    "ExtractAdminLevels": [
      2,
      4
    ],
    "SimplifyToleranceDegrees": 0.002,
    "PullConcurrency": 3,
    "RetryCount": 3,
    "InactivityTimeoutSeconds": 60,
    "OsmiumPath": "osmium",
    "RunOnStartup": true
  },
  "Storage": {
    "DatabasePath": "geodata/state/geotools.db"
  },
  "Features": {
    "MapGrid": true,
    "MapCrosshair": true,
    "GeodataAutoPull": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
