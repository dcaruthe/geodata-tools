{
  "Urls": "http://127.0.0.1:5180",
  "AllowedHosts": "127.0.0.1;localhost",
  "Storage": {
    "DatabasePath": "geodata/state/geotools.db",
    "ReadOnly": true
  },
  "Link": {
    "Enabled": true,
    "SocketPath": "geodata/state/launcher.sock",
    "KeyPath": "geodata/state/launcher.key",
    "RotateSeconds": 900,
    "CommandTimeoutSeconds": 10,
    "HandshakeTimeoutSeconds": 5
  },
  "Window": {
    "Title": "GeoTools",
    "Width": 1200,
    "Height": 800
  },
  "Map": {
    "AdminLevels": [
      2
    ]
  },
  "Geodata": {
    "RootPath": "geodata",
    "BordersSubdirectory": "borders",
    "Regions": [
      "africa",
      "antarctica",
      "asia",
      "australia-oceania",
      "central-america",
      "europe",
      "north-america",
      "south-america"
    ],
    "SourceBaseUrl": "https://download.geofabrik.de/",
    "SourceFilePattern": "{region}-latest.osm.pbf",
    "ExtractAdminLevels": [
      2,
      4
    ],
    "SimplifyToleranceDegrees": 0.002,
    "PullConcurrency": 3,
    "RetryCount": 3,
    "InactivityTimeoutSeconds": 60,
    "OsmiumPath": "osmium",
    "RunOnStartup": false
  },
  "Features": {
    "MapGrid": true,
    "MapCrosshair": true,
    "GeodataAutoPull": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
